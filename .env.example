# Comma-separated API key pool (at least 2 keys, ordered key_1, key_2, ...)
LLM_API_KEYS=your-first-api-key-here,your-second-api-key-here

# SQLite database file URL (use sqlite:////data/app.db for Docker persistence)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of allowed CORS origins for FastAPI
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure request header for failover testing (true/false)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model identifier to use (e.g. gemini/gemini-2.0-flash, gpt-4o-mini, etc.)
LLM_MODEL=gemini/gemini-2.0-flash

# Backend server port
PORT=8000
